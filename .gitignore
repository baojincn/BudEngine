# .gitignore
# Build directories
build/
cmake-build-*/
out/
vcpkg/
vcpkg_installed/

# Generated files
/aftermath_dumps/
/data/
/Cache/
/AssetCache/


# IDE files
.vs/
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Compiler artifacts
*.obj
*.pdb
*.lib
*.dll
*.so
*.dylib

# Third party (but keep the directory structure)
third_party/*/!.gitkeep
third_party/*/.gitignore

# Logs
*.log
*.tmp
.agents/
.claude/
.cursor/
.gemini/
temp/
tmp/
.clinerules/



# CMake cache
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Visual Studio
*.sln
*.vcxproj*
*.user
*.filters
ipch/


# Shaders
*.spv
*.pdb
*.ilk

# Generated headers
include/generated/shader_layouts.h
/bin/Debug

# Runtime-generated config
imgui.ini

# Binary assets and cooked packages (only keep scene configs and default textures in Content/)
*.budasset
*.budbulk
Content/**
!Content/
!Content/Scenes/
!Content/Scenes/**
!Content/Textures/
!Content/Textures/default.png
!Content/**/default.png
!Content/**/.gitkeep
