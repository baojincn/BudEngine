#version 460

layout(local_size_x = 256) in;

struct draw_data {
    uint index_count;
    uint first_index;
    int vertex_offset;
    uint material_id;
    vec3 min;
    uint mesh_id;
    vec3 max;
    uint meshlet_start;
    uint meshlet_count;
    uint flags;
    uint page_index;
    uint visibility_offset;
};

struct indirect_command {
    uint index_count;
    uint instance_count;
    uint first_index;
    int vertex_offset;
    uint first_instance;
};

layout(std430, set = 0, binding = 0) readonly buffer InstanceDataBuffer {
    draw_data data[];
} instance_data;

layout(std430, set = 0, binding = 2) writeonly buffer IndirectDrawBuffer {
    indirect_command data[];
} indirect_draw;

layout(set = 0, binding = 4) uniform uniform_buffer_object {
    mat4 view;
    mat4 proj;
    mat4 cascade_view_proj[4];
    vec4 cascade_split_depths;
    vec3 cam_pos;
    vec3 light_dir;
    vec3 light_color;
    float light_intensity;
    float ambient_strength;
    uint cascade_count;
    uint debug_cascades;
    uint reversed_z;
    float shadow_bias_constant;
    float shadow_bias_slope;
    uint debug_cluster;
} ubo;

layout(push_constant) uniform PushConstants {
    uint total_instances;
    uint did_copy;   // If 1, we skip drawing static objects (flags & 2)
    uint static_only; // If 1, we ONLY emit static objects (for the static cache)
} pc;

bool aabb_visible(vec3 bmin, vec3 bmax, mat4 view_proj)
{
    mat4 clip_matrix = transpose(view_proj);

    vec4 planes[6];
    planes[0] = clip_matrix[3] + clip_matrix[0];
    planes[1] = clip_matrix[3] - clip_matrix[0];
    planes[2] = clip_matrix[3] + clip_matrix[1];
    planes[3] = clip_matrix[3] - clip_matrix[1];
    // Correct frustum plane extraction for Vulkan clip space (z in [0,1]).
    // For reversed-z, near and far are swapped.
    if (ubo.reversed_z == 1u) {
        planes[4] = clip_matrix[3] - clip_matrix[2]; // near (z=1)
        planes[5] = clip_matrix[2];                   // far  (z=0)
    } else {
        planes[4] = clip_matrix[2];                   // near (z=0)
        planes[5] = clip_matrix[3] - clip_matrix[2]; // far  (z=1)
    }

    for (int i = 0; i < 6; ++i) {
        float plane_length = length(planes[i].xyz);
        if (plane_length > 0.0) {
            planes[i] /= plane_length;
        }

        vec3 positive_vertex = vec3(
            planes[i].x >= 0.0 ? bmax.x : bmin.x,
            planes[i].y >= 0.0 ? bmax.y : bmin.y,
            planes[i].z >= 0.0 ? bmax.z : bmin.z);

        if (dot(planes[i].xyz, positive_vertex) + planes[i].w < 0.0) {
            return false;
        }
    }

    return true;
}

void main()
{
    uint draw_index = gl_GlobalInvocationID.x;
    if (draw_index >= pc.total_instances) return;

    draw_data draw = instance_data.data[draw_index];

    bool is_static = (draw.flags & 2u) != 0u;
    bool keep = true;
    if (pc.static_only == 1u)
        keep = is_static;              // static cache pass: only static casters
    else if (pc.did_copy == 1u)
        keep = !is_static;             // dynamic pass: statics come from the cache

    for (uint i = 0; i < ubo.cascade_count; ++i) {
        bool visible = keep && aabb_visible(draw.min, draw.max, ubo.cascade_view_proj[i]);

        indirect_command command;
        command.index_count = draw.index_count;
        command.instance_count = visible ? 1u : 0u;
        command.first_index = draw.first_index;
        command.vertex_offset = draw.vertex_offset;
        command.first_instance = draw_index;

        indirect_draw.data[i * pc.total_instances + draw_index] = command;
    }
}
