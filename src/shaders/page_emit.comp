#version 460
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;



struct VisibleCluster {
    uint instance_and_page; // (instance_id << 16) | page_slot
    uint cluster_idx;
};

layout(std430, set = 0, binding = 0) readonly buffer PagePoolBuffer {
    uint data[];
} page_pool;

layout(std430, set = 0, binding = 1) buffer MeshletVisibilityBuffer {
    uint visible_page_count;
    uint visible_pages[]; // packed: (instance_id << 16) | (page_slot & 0xFFFF)
} in_visibility;

layout(std430, set = 0, binding = 2) buffer VisibleClusterBuffer {
    uint visible_cluster_count;
    VisibleCluster visible_clusters[];
} out_clusters;

layout(push_constant) uniform PushConstants {
    uint max_clusters;
} pc;

const uint PAGE_SIZE_BYTES = 131072;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // Read count from buffer
    uint page_count = in_visibility.visible_page_count;
    if (idx >= page_count) return;

    uint page_val = in_visibility.visible_pages[idx];
    uint instance_id = page_val >> 16;
    uint page_slot = page_val & 0xFFFF;

    uint pool_offset = page_slot * PAGE_SIZE_BYTES;
    // cluster_count is the 3rd uint in VGPageDataHeader (offset 8 bytes)
    uint cluster_count = page_pool.data[pool_offset / 4u + 2u];

    for (uint c = 0; c < cluster_count; ++c) {
        uint out_idx = atomicAdd(out_clusters.visible_cluster_count, 1);
        if (out_idx < pc.max_clusters) {
            out_clusters.visible_clusters[out_idx].instance_and_page = page_val;
            out_clusters.visible_clusters[out_idx].cluster_idx = c;
        }
    }
}