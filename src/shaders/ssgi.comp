#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D in_depth_sampler;
layout(set = 0, binding = 1) uniform sampler2D in_color_sampler;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D out_ssgi_raw;

layout(push_constant) uniform SSGIPushConsts {
    mat4 proj;
    mat4 inv_proj;
    vec2 screen_size;
    float max_distance;
    float thickness;
    uint ray_count;
    uint max_steps;
    float intensity;
    uint frame_index;
    uint reversed_z;
    float padding;
} pc;

const float PI = 3.14159265358979323846;

// Static Interleaved Gradient Noise (locked to pixel grid to prevent traveling waves and flickering)
float interleaved_gradient_noise(vec2 pos) {
    return fract(52.9829189 * fract(dot(pos, vec2(0.06711056, 0.00583715))));
}

vec3 reconstruct_view_pos(vec2 uv, float raw_depth) {
    vec4 clip = vec4(uv * 2.0 - 1.0, raw_depth, 1.0);
    vec4 view = pc.inv_proj * clip;
    if (abs(view.w) > 1e-6)
        view /= view.w;
    return view.xyz;
}

vec3 reconstruct_view_normal(vec2 uv, float raw_depth) {
    vec2 texel = 1.0 / pc.screen_size;
    float d_r = texture(in_depth_sampler, uv + vec2(texel.x, 0.0)).r;
    float d_l = texture(in_depth_sampler, uv - vec2(texel.x, 0.0)).r;
    float d_u = texture(in_depth_sampler, uv + vec2(0.0, texel.y)).r;
    float d_d = texture(in_depth_sampler, uv - vec2(0.0, texel.y)).r;

    vec3 p_c = reconstruct_view_pos(uv, raw_depth);
    vec3 p_r = reconstruct_view_pos(uv + vec2(texel.x, 0.0), d_r);
    vec3 p_l = reconstruct_view_pos(uv - vec2(texel.x, 0.0), d_l);
    vec3 p_u = reconstruct_view_pos(uv + vec2(0.0, texel.y), d_u);
    vec3 p_d = reconstruct_view_pos(uv - vec2(0.0, texel.y), d_d);

    vec3 dx = (abs(p_r.z - p_c.z) < abs(p_l.z - p_c.z)) ? (p_r - p_c) : (p_c - p_l);
    vec3 dy = (abs(p_u.z - p_c.z) < abs(p_d.z - p_c.z)) ? (p_u - p_c) : (p_c - p_d);

    vec3 n = cross(dx, dy);
    // Ensure normal points TOWARDS camera in view space (p_c is at negative Z)
    if (dot(n, -p_c) < 0.0) {
        n = -n;
    }
    float len = length(n);
    if (len > 1e-5)
        return normalize(n);
    return vec3(0.0, 0.0, 1.0);
}

// Generate cosine-weighted hemisphere ray in local tangent space
vec3 cosine_sample_hemisphere(vec2 u) {
    float r = sqrt(u.x);
    float theta = 2.0 * PI * u.y;
    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(max(0.0, 1.0 - u.x));
    return vec3(x, y, z);
}

// Build orthonormal basis (T, B, N)
mat3 build_orthonormal_basis(vec3 N) {
    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);
    return mat3(tangent, bitangent, N);
}

void main() {
    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coord.x >= int(pc.screen_size.x) || pixel_coord.y >= int(pc.screen_size.y))
        return;

    vec2 uv = (vec2(pixel_coord) + 0.5) / pc.screen_size;
    float raw_depth = texture(in_depth_sampler, uv).r;

    bool is_sky = (pc.reversed_z != 0u) ? (raw_depth <= 1e-6) : (raw_depth >= 1.0 - 1e-6);
    if (is_sky) {
        imageStore(out_ssgi_raw, pixel_coord, vec4(0.0));
        return;
    }

    vec3 view_pos = reconstruct_view_pos(uv, raw_depth);
    vec3 view_normal = reconstruct_view_normal(uv, raw_depth);
    mat3 TBN = build_orthonormal_basis(view_normal);

    // Static per-pixel blue noise phase (zero temporal shift to lock geometry silhouettes)
    float spatial_noise = interleaved_gradient_noise(vec2(pixel_coord));

    vec3 accumulated_radiance = vec3(0.0);
    float accumulated_weight = 0.0;

    uint ray_count = max(4u, pc.ray_count);
    uint max_steps = max(16u, pc.max_steps);
    float max_dist = max(2.0, pc.max_distance);

    for (uint r = 0; r < ray_count; ++r) {
        // Stratified elevation and isotropic azimuth distribution
        float u_elevation = (float(r) + 0.5) / float(ray_count);
        float u_azimuth = fract(spatial_noise + float(r) * 0.61803398875);
        vec2 xi = vec2(u_elevation, u_azimuth);

        vec3 local_ray = cosine_sample_hemisphere(xi);
        vec3 ray_dir = normalize(TBN * local_ray);

        // Continuous raymarch step jitter
        float step_size = max_dist / float(max_steps);
        float step_jitter = fract(spatial_noise * 1.61803398875 + float(r) * 0.25);
        float current_dist = step_size * (0.25 + 0.75 * step_jitter);

        vec3 hit_radiance = vec3(0.0);

        for (uint s = 0; s < max_steps; ++s) {
            vec3 sample_view_pos = view_pos + ray_dir * current_dist;

            vec4 clip_pos = pc.proj * vec4(sample_view_pos, 1.0);
            if (clip_pos.w <= 1e-4)
                break;

            vec2 sample_uv = (clip_pos.xy / clip_pos.w) * 0.5 + 0.5;
            if (sample_uv.x < 0.0 || sample_uv.x > 1.0 || sample_uv.y < 0.0 || sample_uv.y > 1.0)
                break;

            float sampled_raw_depth = texture(in_depth_sampler, sample_uv).r;
            bool is_sample_sky = (pc.reversed_z != 0u) ? (sampled_raw_depth <= 1e-6) : (sampled_raw_depth >= 1.0 - 1e-6);
            if (is_sample_sky) {
                current_dist += step_size;
                continue;
            }

            vec3 sampled_view_pos = reconstruct_view_pos(sample_uv, sampled_raw_depth);

            float depth_diff = sample_view_pos.z - sampled_view_pos.z;
            float adaptive_thickness = max(pc.thickness, abs(sample_view_pos.z) * 0.06 + 0.1);

            // In view space, negative Z is in front of camera
            // Hit condition: sample point is behind surface, within adaptive thickness
            if (depth_diff < 0.0 && abs(depth_diff) < adaptive_thickness && current_dist > 0.08) {
                vec3 sampled_normal = reconstruct_view_normal(sample_uv, sampled_raw_depth);

                // Check if hit surface faces towards ray origin
                if (dot(sampled_normal, -ray_dir) > 0.05) {
                    vec3 radiance = texture(in_color_sampler, sample_uv).rgb;
                    // Firefly clamp
                    radiance = min(radiance, vec3(3.0));

                    // Distance falloff with smooth cutoff
                    float dist_fade = clamp(1.0 - (current_dist / max_dist), 0.0, 1.0);
                    dist_fade *= dist_fade;

                    // Screen edge attenuation
                    vec2 edge_dist = min(sample_uv, 1.0 - sample_uv);
                    float edge_fade = smoothstep(0.0, 0.08, min(edge_dist.x, edge_dist.y));

                    hit_radiance = radiance * dist_fade * edge_fade;
                    break;
                }
            }

            current_dist += step_size;
        }

        accumulated_radiance += hit_radiance;
        accumulated_weight += 1.0;
    }

    vec3 final_ssgi = (accumulated_weight > 0.0) ? (accumulated_radiance / accumulated_weight) * pc.intensity : vec3(0.0);
    final_ssgi = min(final_ssgi, vec3(6.0));

    imageStore(out_ssgi_raw, pixel_coord, vec4(final_ssgi, 1.0));
}
