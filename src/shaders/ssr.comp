#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D depth_sampler;
layout(set = 0, binding = 1) uniform sampler2D color_sampler;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D out_ssr_image;

layout(push_constant) uniform SSRPushConsts {
    mat4 proj;
    mat4 inv_proj;
    vec2 screen_size;
    float max_distance;
    float thickness;
    uint max_steps;
    uint binary_steps;
    float intensity;
    uint reversed_z;
    vec2 padding;
} pc;

vec3 reconstruct_view_pos(vec2 uv, float raw_depth) {
    vec4 clip = vec4(uv * 2.0 - 1.0, raw_depth, 1.0);
    vec4 view = pc.inv_proj * clip;
    if (abs(view.w) > 1e-6)
        view /= view.w;
    return view.xyz;
}

vec3 reconstruct_view_normal(vec2 uv, float raw_depth) {
    vec2 texel_size = 1.0 / pc.screen_size;
    float d_right = texture(depth_sampler, uv + vec2(texel_size.x, 0.0)).r;
    float d_left  = texture(depth_sampler, uv - vec2(texel_size.x, 0.0)).r;
    float d_up    = texture(depth_sampler, uv + vec2(0.0, texel_size.y)).r;
    float d_down  = texture(depth_sampler, uv - vec2(0.0, texel_size.y)).r;

    vec3 p_c     = reconstruct_view_pos(uv, raw_depth);
    vec3 p_right = reconstruct_view_pos(uv + vec2(texel_size.x, 0.0), d_right);
    vec3 p_left  = reconstruct_view_pos(uv - vec2(texel_size.x, 0.0), d_left);
    vec3 p_up    = reconstruct_view_pos(uv + vec2(0.0, texel_size.y), d_up);
    vec3 p_down  = reconstruct_view_pos(uv - vec2(0.0, texel_size.y), d_down);

    vec3 dx = (abs(p_right.z - p_c.z) < abs(p_left.z - p_c.z)) ? (p_right - p_c) : (p_c - p_left);
    vec3 dy = (abs(p_up.z - p_c.z) < abs(p_down.z - p_c.z)) ? (p_up - p_c) : (p_c - p_down);

    vec3 N = cross(dx, dy);
    // Ensure normal points TOWARDS camera in view space (p_c is at negative Z)
    if (dot(N, -p_c) < 0.0) {
        N = -N;
    }
    float len = length(N);
    if (len > 1e-5)
        return normalize(N);
    return vec3(0.0, 0.0, 1.0);
}

void main() {
    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coord.x >= int(pc.screen_size.x) || pixel_coord.y >= int(pc.screen_size.y))
        return;

    vec2 uv = (vec2(pixel_coord) + 0.5) / pc.screen_size;
    float raw_depth = texture(depth_sampler, uv).r;

    // Check if background / sky
    bool is_sky = (pc.reversed_z != 0u) ? (raw_depth <= 1e-6) : (raw_depth >= 1.0 - 1e-6);
    if (is_sky) {
        imageStore(out_ssr_image, pixel_coord, vec4(0.0));
        return;
    }

    vec3 view_pos = reconstruct_view_pos(uv, raw_depth);
    vec3 N = reconstruct_view_normal(uv, raw_depth);
    vec3 V = normalize(-view_pos);

    vec3 R = reflect(-V, N);

    // If reflection vector points into geometry surface, discard
    if (dot(R, N) <= 0.01) {
        imageStore(out_ssr_image, pixel_coord, vec4(0.0));
        return;
    }

    // Raymarching in View Space
    float max_dist = max(5.0, pc.max_distance);
    uint steps = clamp(pc.max_steps, 16u, 64u);
    float step_size = max_dist / float(steps);

    // Adaptive starting bias to prevent self-intersection of floor/walls
    vec3 ray_start = view_pos + N * (0.04 + 0.02 * clamp(abs(view_pos.z) * 0.02, 0.0, 0.5));
    float current_dist = step_size * 0.5;

    bool hit = false;
    vec2 hit_uv = vec2(0.0);

    for (uint i = 0u; i < steps; ++i) {
        vec3 sample_pos = ray_start + R * current_dist;
        vec4 clip_pos = pc.proj * vec4(sample_pos, 1.0);
        if (clip_pos.w <= 0.001)
            break;

        vec2 sample_uv = (clip_pos.xy / clip_pos.w) * 0.5 + 0.5;
        if (sample_uv.x < 0.0 || sample_uv.x > 1.0 || sample_uv.y < 0.0 || sample_uv.y > 1.0)
            break;

        // Skip self-intersection on the starting pixel
        if (length(sample_uv - uv) < 0.003 && current_dist < step_size * 1.5) {
            current_dist += step_size;
            continue;
        }

        float sampled_raw_depth = texture(depth_sampler, sample_uv).r;
        bool is_sample_sky = (pc.reversed_z != 0u) ? (sampled_raw_depth <= 1e-6) : (sampled_raw_depth >= 1.0 - 1e-6);
        if (is_sample_sky) {
            current_dist += step_size;
            continue;
        }

        vec3 sampled_view_pos = reconstruct_view_pos(sample_uv, sampled_raw_depth);

        // In view space, negative Z is in front of camera.
        // If ray point is behind the surface depth:
        float depth_diff = sample_pos.z - sampled_view_pos.z;
        float adaptive_thickness = max(pc.thickness, abs(sample_pos.z) * 0.05 + 0.1);

        if (depth_diff < 0.0 && abs(depth_diff) < adaptive_thickness && current_dist > 0.08) {
            // Reject backfaces of foreground objects (avoids ghosting/glass overlay artifacts)
            vec3 sampled_normal = reconstruct_view_normal(sample_uv, sampled_raw_depth);
            if (dot(sampled_normal, -R) < 0.1) {
                current_dist += step_size;
                continue;
            }

            // Binary refinement (strictly bounded to [min_dist, max_dist_bin])
            float min_dist = max(0.0, current_dist - step_size);
            float max_dist_bin = current_dist;

            for (uint b = 0u; b < pc.binary_steps; ++b) {
                float mid_dist = (min_dist + max_dist_bin) * 0.5;
                vec3 mid_pos = ray_start + R * mid_dist;
                vec4 mid_clip = pc.proj * vec4(mid_pos, 1.0);
                if (mid_clip.w <= 0.001)
                    break;
                vec2 mid_uv = (mid_clip.xy / mid_clip.w) * 0.5 + 0.5;
                if (mid_uv.x < 0.0 || mid_uv.x > 1.0 || mid_uv.y < 0.0 || mid_uv.y > 1.0)
                    break;

                float mid_raw_depth = texture(depth_sampler, mid_uv).r;
                bool is_mid_sky = (pc.reversed_z != 0u) ? (mid_raw_depth <= 1e-6) : (mid_raw_depth >= 1.0 - 1e-6);
                if (is_mid_sky) {
                    min_dist = mid_dist;
                    continue;
                }

                vec3 mid_sampled_pos = reconstruct_view_pos(mid_uv, mid_raw_depth);

                if (mid_pos.z < mid_sampled_pos.z) {
                    max_dist_bin = mid_dist;
                } else {
                    min_dist = mid_dist;
                }
            }

            float final_dist = (min_dist + max_dist_bin) * 0.5;
            vec3 final_pos = ray_start + R * final_dist;
            vec4 final_clip = pc.proj * vec4(final_pos, 1.0);
            hit_uv = (final_clip.xy / final_clip.w) * 0.5 + 0.5;
            hit = true;
            break;
        }

        current_dist += step_size;
    }

    if (hit) {
        // Screen-edge attenuation (smooth fade out near screen borders)
        vec2 edge_dist = min(hit_uv, 1.0 - hit_uv);
        float edge_factor = smoothstep(0.0, 0.08, min(edge_dist.x, edge_dist.y));

        // Distance attenuation
        float dist_factor = clamp(1.0 - (current_dist / max_dist), 0.0, 1.0);
        dist_factor *= dist_factor;

        // Sample scene color
        vec3 reflection_color = texture(color_sampler, hit_uv).rgb;
        float alpha = edge_factor * dist_factor * pc.intensity;

        imageStore(out_ssr_image, pixel_coord, vec4(reflection_color, alpha));
    } else {
        imageStore(out_ssr_image, pixel_coord, vec4(0.0));
    }
}
